# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a GitHub.

# Token del bot (@BotFather). Obligatorio.
TELEGRAM_TOKEN=

# Clave de la API de Anthropic (https://console.anthropic.com). Opcional:
# sin ella el bot funciona solo con comandos/reglas; con ella conversa libremente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Base de datos y zona horaria
DB_PATH=helassist.db
TIMEZONE=America/Bogota

# Whisper (notas de voz): tiny | base | small | medium
WHISPER_MODEL=base

# Opcional: IDs de Telegram permitidos, separados por coma (vacío = cualquiera puede usarlo)
ALLOWED_USERS=

# Máximo de mensajes por minuto por usuario hacia la IA (control de costos)
LLM_MAX_POR_MINUTO=12
# Tope diario de mensajes a la IA por usuario y para todo el bot (0 = sin límite)
LLM_MAX_POR_DIA=40
LLM_MAX_DIA_TOTAL=3000

# Pedir autorización de tratamiento de datos al iniciar (si/no). Déjalo en "si" con usuarios reales.
EXIGIR_AVISO_PRIVACIDAD=si
HORA_RECORDATORIO_DEFECTO=09:00

# Respaldo automático diario de la base de datos (carpeta vacía = «backups» junto a la base)
BACKUP_DIR=
BACKUPS_CONSERVAR=7
